{
  "name": "mathtwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "eval:read": "npm run build && node tools/eval/dist/cli.js",
    "eval:generate": "npm run build && node tools/eval/dist/generate-cli.js",
    "eval:validate": "npm run build && node tools/eval/dist/validate-cli.js"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
