{
  "name": "mathtwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mathtwin/core --workspace @mathtwin/reader --workspace @mathtwin/reader-llamacpp-shared --workspace @mathtwin/reader-llamacpp --workspace @mathtwin/reader-ocr-shared --workspace @mathtwin/reader-ocr --workspace @mathtwin/reader-figure --workspace @mathtwin/work --workspace @mathtwin/eval --workspace @mathtwin/models",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @mathtwin/mobile",
    "test": "npm run typecheck && vitest run",
    "eval:read": "npm run build && node tools/eval/dist/cli.js",
    "eval:generate": "npm run build && node tools/eval/dist/generate-cli.js",
    "eval:pack": "npm run build && node tools/eval/dist/pack.js",
    "eval:validate": "npm run build && node tools/eval/dist/validate-cli.js",
    "models:fetch": "npm run build --workspace @mathtwin/models && node tools/models/dist/cli.js",
    "mobile:build": "node apps/mobile/scripts/build.mjs",
    "mobile:install": "node apps/mobile/scripts/install.mjs",
    "mobile:dev": "npm run dev --workspace @mathtwin/mobile",
    "eval:effort": "npm run build && node tools/eval/dist/effort-cli.js",
    "eval:work": "npm run build && node tools/eval/dist/work-cli.js",
    "eval:generate-work": "npm run build && node tools/eval/dist/work-generate-cli.js",
    "eval:generate-work-tables": "npm run build && node tools/eval/dist/work-tables-cli.js"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
